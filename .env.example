# --- Base de datos (Supabase) -------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# (puerto 6543). RevuTags solo usa el schema "revu".
DATABASE_URL=postgresql://postgres.mqlfptujypzofidvmjnb:[PASSWORD]@[HOST].pooler.supabase.com:6543/postgres

# --- Caché y rate limit (Upstash Redis) — opcional ------------------------------
# Sin ellas todo funciona contra Postgres y sin rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Panel /admin (email + contraseña) -----------------------------------------
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=
# Emails con acceso al panel, separados por comas. Además cada uno necesita
# contraseña en revu.admin_users:  npm run admin:password -- tu@email.com
ADMIN_EMAILS=lopezalegreiker@gmail.com
# Base de las URLs exportadas en los lotes.
PUBLIC_BASE_URL=https://revutags.com

# --- Página de "tag no activado" ---------------------------------------------
WHATSAPP_NUMBER=34675977794

# --- Google Places: buscador del panel + snapshot diario de reseñas ----------
GOOGLE_PLACES_KEY=
# Mínimo 16 caracteres. Vercel lo manda como "Authorization: Bearer ..." al cron.
CRON_SECRET=
