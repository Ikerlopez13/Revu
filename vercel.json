{
  "rewrites": [
    {
      "source": "/configurador",
      "destination": "/configurador/index.html"
    },
    {
      "source": "/m",
      "destination": "/api/r/[slug]?slug=m"
    },
    {
      "source": "/m/:code",
      "destination": "/api/r/[slug]?slug=:code"
    },
    {
      "source": "/(birres|samalica|palomera|caseta|amura|escora|hivernacle|taranna|clandestin|nvareformes|amat|bellesa|b|s|p|c|a|e|h|t|cl|nva|n|n1|tb1|b1|s1|p1|c1|a1|e1|h1)",
      "destination": "/api/r/[slug]?slug=$1"
    }
  ]
}
